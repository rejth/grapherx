{
  "name": "grapherx",
  "version": "0.1.1",
  "description": "TypeScript library for working with directed graphs",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run check && npm run lint && npm run test && npm run build",
    "test": "jest --runInBand --colors --config jest.config.ts",
    "lint": "npx oxlint src",
    "lint:fix": "npx oxlint src --fix",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "check-updates": "npx npm-check-updates",
    "update-packages": "npx npm-check-updates -u",
    "prepare": "node -e \"if(process.env.INIT_CWD===process.cwd()){require('husky').install()}\""
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "biome check --write",
      "oxlint --fix"
    ]
  },
  "author": "Ilya Kirsanov",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rejth/grapherx.git"
  },
  "homepage": "https://github.com/rejth/grapherx#readme",
  "bugs": {
    "url": "https://github.com/rejth/grapherx/issues"
  },
  "keywords": [
    "graph",
    "directed-graph",
    "dag",
    "topological-sort",
    "bfs",
    "dfs",
    "shortest-path",
    "typescript"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/jest": "^29.5.4",
    "husky": "^8.0.3",
    "jest": "^29.6.4",
    "lint-staged": "^14.0.1",
    "np": "^8.0.4",
    "npm-check-updates": "^16.13.3",
    "oxlint": "^1.57.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ttypescript": "^1.5.15",
    "typescript": "^5.2.2"
  }
}
