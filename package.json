{
  "name": "grapherx",
  "version": "1.0.0",
  "description": "Simple library for work with directed acyclic graphs",
  "main": "./dist/src/index.js",
  "types": "./types/src/types.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "declarations": "ttsc --emitDeclarationOnly",
    "test": "jest --runInBand --colors --config jest.config.ts",
    "lint": "npx oxlint src",
    "lint:fix": "npx oxlint src --fix",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "check-updates": "npx npm-check-updates",
    "update-packages": "npx npm-check-updates -u",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": ["biome check --write", "oxlint --fix"]
  },
  "author": "Ilya Kirsanov",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/jest": "^29.5.4",
    "husky": "^8.0.3",
    "jest": "^29.6.4",
    "lint-staged": "^14.0.1",
    "np": "^8.0.4",
    "npm-check-updates": "^16.13.3",
    "oxlint": "^1.57.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ttypescript": "^1.5.15",
    "typescript": "^5.2.2"
  }
}
